<?xml version='1.0' encoding='utf-8'?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.flowlabs.vicehub">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_dark"
        android:roundIcon="@mipmap/ic_dark"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:resizeableActivity="false">

        <!-- a tela do app; quem aparece na gaveta de apps são os aliases abaixo -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"/>

        <!-- ícone "dark" (trocado em Ajustes → Ícone do app) -->
        <activity-alias
            android:name=".IconDark"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_dark"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- ícone "vice" (trocado em Ajustes → Ícone do app) -->
        <activity-alias
            android:name=".IconVice"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_vice"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- ícone "neon" (trocado em Ajustes → Ícone do app) -->
        <activity-alias
            android:name=".IconNeon"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_neon"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- ícone "gold" (trocado em Ajustes → Ícone do app) -->
        <activity-alias
            android:name=".IconGold"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_gold"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- ícone "white" (trocado em Ajustes → Ícone do app) -->
        <activity-alias
            android:name=".IconWhite"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_white"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- ícone "ocean" (trocado em Ajustes → Ícone do app) -->
        <activity-alias
            android:name=".IconOcean"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_ocean"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <meta-data
          android:name="android.max_aspect"
          android:value="4.0"/>

    </application>

</manifest>
